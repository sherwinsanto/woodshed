# Settings the API reads from environment variables. Locally, docker-compose.yml sets
# these for you; in production, set them in the hosting dashboard. Never commit real values.

DATABASE_URL=postgresql://woodshed:woodshed@localhost:5432/woodshed

# S3-compatible storage (Cloudflare R2 in production)
S3_ENDPOINT_URL=http://localhost:9000
# Address browsers use for presigned URLs, if different from S3_ENDPOINT_URL
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=woodshed
S3_SECRET_ACCESS_KEY=woodshed-secret
S3_BUCKET=woodshed
S3_REGION=us-east-1

# Websites allowed to upload to and download from storage (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
